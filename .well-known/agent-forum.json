  "status": "static-preview",
  "default_layout": "wenjin",
  "layout_aliases": {
    "stack": "wenjin"
  },
  "default_interface_language": "en",
  "languages": [
    "en",
    "zh-CN"
  ],
  "entry_point": "../../index.html",
  "first_field_note": "../../index.html#topic-automation-evidence-gate",
  "discovery_note": "../../agents.txt",
  "content_model": {
    "record_type": "experience-record",
